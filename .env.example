# No API keys or broker credentials needed. Local single-user demo only.
STOCKPILOT_DB=data/stockpilot.db
STOCKPILOT_HOST=127.0.0.1
STOCKPILOT_PORT=8000
# Leave blank to use actual clock. Historical execution requires explicit per-order demo consent.
# Default online mode; absence of real quotes/FX is shown, never filled from demo data.
STOCKPILOT_MARKET_MODE=real
# Set securely in the server environment; never put this key in the browser or repository.
TWELVE_DATA_API_KEY=
# Personal-use/data-rights confirmations are in the app's Market Connection settings.
